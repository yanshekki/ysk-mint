{
  "name": "@ysk-mint/config",
  "version": "1.4.0",
  "description": "Chain registry, contract addresses, and numeric bounds for YSK Mint.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./enum-parity.json": "./enum-parity.json"
  },
  "files": [
    "dist",
    "enum-parity.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanshekki/ysk-mint.git",
    "directory": "packages/config"
  },
  "homepage": "https://mint.ysk.hk",
  "bugs": {
    "url": "https://github.com/yanshekki/ysk-mint/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
