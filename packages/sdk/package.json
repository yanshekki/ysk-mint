{
  "name": "@ysk-mint/sdk",
  "version": "1.3.0",
  "description": "Enums, error codes, validation, and OFT helpers for YSK Mint.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanshekki/ysk-mint.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://mint.ysk.hk",
  "bugs": {
    "url": "https://github.com/yanshekki/ysk-mint/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ysk-mint/config": "workspace:*",
    "viem": "^2.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
