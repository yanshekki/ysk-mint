{
  "name": "ysk-mint",
  "version": "1.2.1",
  "private": true,
  "description": "On-chain markets, holdings, and token launch. No backend. No custody.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm test:contracts && pnpm test:sdk",
    "test:contracts": "forge test -vv",
    "test:sdk": "pnpm --filter @ysk-mint/sdk test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:web": "pnpm --filter @ysk-mint/web dev",
    "build:web": "pnpm --filter @ysk-mint/web build",
    "docs:bilingual": "node scripts/docs-bilingual-check.mjs",
    "snapshot:top500": "node scripts/snapshot-top500.mjs",
    "snapshot:labels": "node scripts/snapshot-labels.mjs"
  }
}
