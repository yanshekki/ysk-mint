{
  "name": "ysk-mint",
  "version": "0.2.0",
  "private": true,
  "description": "Guided multi-chain token launcher with native OFT, LP creation, and locking. No backend — on-chain data only.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm test:contracts && pnpm test:sdk",
    "test:contracts": "forge test -vv",
    "test:sdk": "pnpm --filter @ysk-mint/sdk test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:web": "pnpm --filter @ysk-mint/web dev",
    "build:web": "pnpm --filter @ysk-mint/web build",
    "docs:bilingual": "node scripts/docs-bilingual-check.mjs"
  }
}
